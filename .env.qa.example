# Ambiente Docker QA — NUNCA copie DATABASE_URL, S3_* ou TIGRIS_* do .env (Aiven/Beta).
# Copie para `.env.qa` (gitignored) e preencha senhas locais.

MYSQL_DATABASE=oju_midia_qa
MYSQL_USER=oju_qa
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host Playwright / app no host → container publicado em 3307
DATABASE_URL=mysql://oju_qa:SENHA@127.0.0.1:3307/oju_midia_qa

E2E_PORT=3100
E2E_BASE_URL=http://127.0.0.1:3100
E2E_ALLOW_MUTATION=1
E2E_DATABASE_ALLOWED_HOSTS=127.0.0.1
E2E_DATABASE_NAME=oju_midia_qa
E2E_DATABASE_PORT=3307
E2E_STORAGE_ISOLATED=1
E2E_STORAGE_PREFIX=qa-auto/
LOCAL_STORAGE_DIR=.qa-storage

# OAuth real: NÃO deixe linhas vazias de GOOGLE_SUPER_ADMIN_* neste arquivo —
# valores vazios sobrescreveriam a allowlist. O Playwright QA herda GOOGLE_* do ambiente
# da máquina e força DATABASE_URL deste arquivo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3100/api/auth/google/callback

# Conta Google QA do participante (não incluir em GOOGLE_SUPER_ADMIN_EMAILS).
# Sem isto, a jornada usa qa-auto.<run>@example.com e não prova OAuth.
# E2E_QA_PARTICIPANT_EMAIL=conta-qa@gmail.com
# E2E_FASE2_CAPTURE_PARTICIPANT=1
# Perfil Chrome separado do Super Admin (pnpm qa:chrome lê estas chaves).
# QA_CHROME_PROFILE=.qa-chrome-profile-participant
# E2E_AUTH_CDP_PORT=9223
# E2E_AUTH_CDP_URL=http://127.0.0.1:9223

OJU_LOCAL_DEV_LOGIN_ENABLED=false
NODE_ENV=development
PORT=3100
