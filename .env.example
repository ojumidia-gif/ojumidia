# Copie para `.env` e preencha os valores reais. Nunca commite `.env`.

# Aplicação
NODE_ENV=development
PORT=3000
JWT_SECRET=

# Banco (Aiven em produção: URL MySQL). Se a URL vier com ssl-mode=, a aplicação converte para a opção ssl do mysql2.
DATABASE_URL=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Opcional. CSV de callbacks extras além do URI canônico acima.
GOOGLE_OAUTH_REDIRECT_URIS=
GOOGLE_SUPER_ADMIN_EMAILS=
GOOGLE_SUPER_ADMIN_SUBS=

# Login local — somente desenvolvimento
OJU_LOCAL_ADMIN_EMAIL=
OJU_LOCAL_DEV_LOGIN_ENABLED=false

# Tigris (S3-compatible). Produção no Render.
# Use S3_* ou os aliases TIGRIS_* (o código aceita os dois).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
TIGRIS_BUCKET=
TIGRIS_ENDPOINT=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Copie para `.env` e preencha os valores reais. Nunca commite `.env`.
# Opcional — LLM/transcrição da área comunitária (endpoint do provedor escolhido)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Storage local só em desenvolvimento, se Tigris/S3 não estiver configurado
LOCAL_STORAGE_DIR=.local-storage

# Cron da Lixeira Editorial (Render Cron Job)
EDITORIAL_TRASH_CRON_SECRET=
OJU_PUBLIC_BASE_URL=

# Opcional — Firebase Web (prévia estática, não é storage de mídia)
VITE_OJU_STATIC_PREVIEW=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Opcional — analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Pagamento da Rede (Fase 6). Sem gateway real até autorização explícita.
# Não invente valor. Deixe vazio até o provedor ser escolhido.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

